{
  "version": 2,
  "builds": [
    {
      "src": "api/admin.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "admin-dashboard/public/**"
      }
    },
    {
      "src": "api/basic.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/hello.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.cjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/admin",
      "dest": "/api/admin.cjs"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/admin.cjs"
    },
    {
      "src": "/basic",
      "dest": "/api/basic.cjs"
    },
    {
      "src": "/hello",
      "dest": "/api/hello.cjs"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.cjs"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "installCommand": "npm install"
}
